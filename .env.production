# Leave empty so the browser calls same-origin paths (/auth, /users, /api).
# Vercel rewrites those to the Railway backend (avoids CORS with the Vercel domain).
VITE_API_BASE=

# Lets signed-in users preview Farmer / Admin / Super Admin portals from the UI.
# Turn off for a production lockdown once real role accounts are in use.
VITE_ENABLE_ROLE_SWITCHER=true
