{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://ds-back-production.up.railway.app/auth/:path*"
    },
    {
      "source": "/users/:path*",
      "destination": "https://ds-back-production.up.railway.app/users/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://ds-back-production.up.railway.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
