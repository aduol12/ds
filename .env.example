# DroughtSmart NestJS API (ds-back-master)

NODE_ENV=development
PORT=3000

# Required in production — never use the default
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=60m
REFRESH_TOKEN_DAYS=30

# Device ingest: keep true until all devices have X-Device-Api-Key
ALLOW_OPEN_INGEST=true

# CORS (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://localhost:5175,https://frontend-six-blond-iqepd2m4y4.vercel.app,https://app.droughtsmartltd.com

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=droughtsmart
# false in production once migrations are in place
DB_SYNCHRONIZE=true

# MQTT (IoT)
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=ds-back

# Cloudinary (profile pictures)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: wrap all responses as { success, data }
TRANSFORM_RESPONSES=false
